@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ĐỊNH DẠNG DANH SÁCH </title>
</head>
<body>
    <div>
        <p>ĐÂY LÀ DANH SÁCH MẸO MÀY BÉ postition inside</p>
        <ul style="list-style-type:square;list-style-position:inside">
            <li>Item 1 </li>
            <li>Item 2 ccccccccccccccccc</li>
            <li>Item 3 </li>
        </ul>
        <p>ĐÂY LÀ DANH SÁCH MẸO MÀY BÉ postition outside</p>
        <ul style="list-style-type:square;list-style-position:outside">
            <li>Item 1 </li>
            <li>Item 2 </li>
            <li>Item 3 cccccccccccccccc </li>
            <p>ĐÂY LÀ DANH SÁCH MẸO MÀY BÉ ko có bullet</p>
            <ul style="list-style-type:none">
                <li>Item 1 </li>
                <li>Item 2 </li>
                <li>Item 3 cccccccccccccccc </li>
            </ul>
</div>
</body>
</html>
